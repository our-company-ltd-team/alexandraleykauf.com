{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "lib": ["es2022"],
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "./dist",
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "migrations", "one-offs"]
}
