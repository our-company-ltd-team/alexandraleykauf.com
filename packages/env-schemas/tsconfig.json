{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Don't generate declarations - consumers import raw .ts
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
