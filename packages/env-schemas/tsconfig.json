{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "rootDir": "./src",
    // Use Bundler resolution since consumers (Next.js) compile the raw .ts files
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Don't generate declarations - consumers import raw .ts
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
