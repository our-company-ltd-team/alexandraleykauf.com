{
  "name": "@alexandraleykauf/contentful-types",
  "type": "commonjs",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "contentful-typescript-codegen --output ./generated/contentful.d.ts",
    "generate:watch": "contentful-typescript-codegen --output ./generated/contentful.d.ts --poll",
    "build": "pnpm generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "contentful": "^11.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "contentful-management": "^11.47.2",
    "contentful-typescript-codegen": "^3.4.0",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "zod": "^3.25.76"
  }
}
