{
  "name": "alexandraleykauf.com",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "pre-commit": "lint-staged && turbo typecheck",
    "prepare": "husky",
    "migrate:generate": "pnpm --filter @alexandraleykauf/contentful-migrations migrate:generate",
    "migrate:run": "pnpm --filter @alexandraleykauf/contentful-migrations migrate:run",
    "migrate:one-off": "pnpm --filter @alexandraleykauf/contentful-migrations migrate:one-off",
    "migrate:status": "pnpm --filter @alexandraleykauf/contentful-migrations migrate:status"
  },
  "dependencies": {
    "@antfu/eslint-config": "^6.2.0"
  },
  "devDependencies": {
    "eslint-plugin-react-dom": "^2.3.13",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.6.1"
  },
  "lint-staged": {
    "packages/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --fix --ignore-pattern '**/generated/**'"
    ]
  }
}
