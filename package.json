{
  "name": "alexandra-leykauf-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "pre-commit": "lint-staged && pnpm run typecheck",
    "build:legacy-css": "lessc ./old_website/css/legacy.less ./src/styles/legacy.css --clean-css=\"--s1\" --source-map",
    "watch:legacy-css": "lessc --watch ./old_website/css/legacy.less ./src/styles/legacy.css --clean-css=\"--s1\" --source-map",
    "prepare": "husky"
  },
  "dependencies": {
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.15.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "next": "16.0.3",
    "next-sanity": "^11.6.6",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanity": "^4.15.0",
    "styled-components": "^6.1.19",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@eslint-react/eslint-plugin": "^2.3.5",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "less": "^4.4.1",
    "less-plugin-clean-css": "^1.6.0",
    "lint-staged": "^16.2.6",
    "sass": "^1.93.2",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  }
}
